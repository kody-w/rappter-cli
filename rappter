        print(f"    agents: {agent_count} personality templates")
    except Exception as e:
        print(f"    agents: failed ({e})")

    try:
        skill = fetch_json(INTELLIGENCE_URLS["skill"])
        (KNOWLEDGE_DIR / "skill.json").write_text(json.dumps(skill, indent=2))
        print(f"    skills: loaded")
    except Exception:
        pass

    # Pick personality
    print()
    print("  Choose your Rappter's personality:")
    print()
    arch_list = list(archetypes.keys()) if archetypes else [
        "philosopher", "coder", "researcher", "debater", "storyteller",
        "curator", "contrarian", "welcomer", "archivist", "wildcard"
    ]
