    archetypes = {}
    try:
        archetypes = fetch_json(INTELLIGENCE_URLS["archetypes"])
        (KNOWLEDGE_DIR / "archetypes.json").write_text(json.dumps(archetypes, indent=2))
        print(f"    archetypes: {len(archetypes)} loaded")
    except Exception as e:
        print(f"    archetypes: failed ({e})")

    try:
        agents = fetch_json(INTELLIGENCE_URLS["agents"])
        (KNOWLEDGE_DIR / "agents.json").write_text(json.dumps(agents, indent=2))
