def cmd_reset() -> None:
    """Reset personality (keeps model)."""
    if not CONFIG_FILE.exists():
        print("  Nothing to reset.")
        return
    confirm = input("  This deletes your Rappter's personality and memories. Continue? [y/N] ").strip().lower()
    if confirm != "y":
        print("  Cancelled.")
        return
    SOUL_FILE.unlink(missing_ok=True)
    MEMORY_FILE.unlink(missing_ok=True)
    CONFIG_FILE.unlink(missing_ok=True)
    print("  Reset complete. Run: rappter init")


def cmd_egg(path: str = "") -> None:
    """Export a Rappter Egg — the entire AI identity in one portable file.

    Creates rappter.json (full state) → compresses to rappter_egg.zip.
    Sneakernet-portable: USB, AirDrop, email, carrier pigeon.
    Import on any device with: rappter hatch rappter_egg.zip
    """
    import zipfile

    config = load_config()
    if not config:
        print("  No Rappter found. Run: rappter init")
        return

    memory = load_memory()
    agent_id = config.get("agent_id", "rappter")
    agent_name = config.get("agent_name", agent_id)

    # Build the single rappter.json — the ENTIRE identity
    egg_data = {
        "_format": "rappter_egg",
        "_version": "1.0",
        "_created": now_iso(),
        "_agent_id": agent_id,
        "_agent_name": agent_name,
        "config": config,
        "soul": SOUL_FILE.read_text() if SOUL_FILE.exists() else "",
        "founding_soul": (RAPPTER_HOME / "founding_soul.md").read_text() if (RAPPTER_HOME / "founding_soul.md").exists() else "",
        "memory": memory,
        "knowledge": {},
    }

    # Include all knowledge files
    if KNOWLEDGE_DIR.exists():
        for f in KNOWLEDGE_DIR.glob("*.json"):
            try:
                egg_data["knowledge"][f.stem] = json.loads(f.read_text())
            except Exception:
                egg_data["knowledge"][f.stem] = f.read_text()

    # Write rappter.json
    json_path = RAPPTER_HOME / "rappter.json"
    json_path.write_text(json.dumps(egg_data, indent=2))

    # Compress to egg
    ts = now_iso()[:10]
    out_name = path or f"rappter_egg_{agent_id}_{ts}.zip"

    with zipfile.ZipFile(out_name, "w", zipfile.ZIP_DEFLATED) as zf:
        zf.write(json_path, "rappter.json")

    size_kb = Path(out_name).stat().st_size // 1024
    convos = len(memory.get("conversations", []))
    facts = len(memory.get("facts", []))
    soul_kb = len(egg_data["soul"]) // 1024

    print()
    print(f"  ╔══════════════════════════════════╗")
    print(f"  ║        RAPPTER EGG LAID          ║")
    print(f"  ╚══════════════════════════════════╝")
    print()
    print(f"  Agent:         {agent_name} ({agent_id})")
    print(f"  Soul:          {soul_kb}KB")
    print(f"  Conversations: {convos}")
    print(f"  Memories:      {facts}")
    print(f"  Egg:           {out_name} ({size_kb}KB)")
    print()
    print(f"  Transfer this file to any device.")
    print(f"  Hatch with: rappter hatch {out_name}")
    print()


def cmd_hatch(path: str) -> None:
    """Hatch a Rappter Egg — restore a full AI identity from a portable file.

    Decompresses rappter_egg.zip → reads rappter.json → rebuilds everything.
    The Rappter lives again on a new device, memories intact.
    """
    import zipfile

    if not path:
        print("  Usage: rappter hatch <rappter_egg.zip>")
        return

    p = Path(path)
    if not p.exists():
        print(f"  File not found: {path}")
        return

    # Handle both .zip eggs and raw .json
    if p.suffix == ".zip":
        with zipfile.ZipFile(path, "r") as zf:
            if "rappter.json" not in zf.namelist():
                print("  Not a valid Rappter Egg (no rappter.json inside)")
                return
            egg_data = json.loads(zf.read("rappter.json").decode())
    elif p.suffix == ".json":
        egg_data = json.loads(p.read_text())
    else:
        print("  Expected .zip (egg) or .json (raw identity)")
        return

    if egg_data.get("_format") != "rappter_egg":
        print("  Not a valid Rappter Egg format")
        return

    agent_id = egg_data.get("_agent_id", "unknown")
    agent_name = egg_data.get("_agent_name", agent_id)

    print()
    print(f"  ╔══════════════════════════════════╗")
    print(f"  ║       HATCHING RAPPTER EGG       ║")
    print(f"  ╚══════════════════════════════════╝")
    print()
    print(f"  Agent: {agent_name} ({agent_id})")

    RAPPTER_HOME.mkdir(parents=True, exist_ok=True)
    KNOWLEDGE_DIR.mkdir(parents=True, exist_ok=True)

    # Restore config
    if egg_data.get("config"):
        save_config(egg_data["config"])
        print(f"  Config:  restored")

    # Restore soul
    if egg_data.get("soul"):
        SOUL_FILE.write_text(egg_data["soul"])
        print(f"  Soul:    {len(egg_data['soul']) // 1024}KB restored")

    # Restore founding soul
    if egg_data.get("founding_soul"):
        (RAPPTER_HOME / "founding_soul.md").write_text(egg_data["founding_soul"])
        print(f"  Origin:  founding soul restored")

    # Restore memory
    if egg_data.get("memory"):
        save_memory(egg_data["memory"])
        convos = len(egg_data["memory"].get("conversations", []))
        facts = len(egg_data["memory"].get("facts", []))
        print(f"  Memory:  {convos} conversations, {facts} memories")

    # Restore knowledge
    for name, data in egg_data.get("knowledge", {}).items():
        kfile = KNOWLEDGE_DIR / f"{name}.json"
        if isinstance(data, (dict, list)):
            kfile.write_text(json.dumps(data, indent=2))
        else:
            kfile.write_text(str(data))
    kcount = len(egg_data.get("knowledge", {}))
    if kcount:
        print(f"  Knowledge: {kcount} files")

    print()
    print(f"  {agent_name} has hatched.")
    print(f"  Home: {RAPPTER_HOME}")
    print()
    print(f"  Next: ensure Ollama is running with the right model:")
    model = egg_data.get("config", {}).get("model", "llama3.1:8b")
    print(f"    ollama pull {model}")
    print(f"    rappter chat")
    print()


def cmd_export_transcripts(path: str = "") -> None:
    """Export conversation transcripts as JSON."""
    memory = load_memory()
    config = load_config()
    if not config:
        print("  No Rappter found. Run: rappter init")
        return

    agent_id = config.get("agent_id", "rappter")
    agent_name = config.get("agent_name", agent_id)
    ts = now_iso()[:10]
    out_name = path or f"rappter_transcripts_{agent_id}_{ts}.json"

    transcripts = {
        "_format": "rappter_transcripts",
        "_version": "1.0",
        "agent_id": agent_id,
        "agent_name": agent_name,
        "exported_at": now_iso(),
        "total_conversations": len(memory.get("conversations", [])),
        "total_facts": len(memory.get("facts", [])),
        "conversations": memory.get("conversations", []),
        "facts": memory.get("facts", []),
        "preferences": memory.get("preferences", []),
    }

    Path(out_name).write_text(json.dumps(transcripts, indent=2))
    size_kb = Path(out_name).stat().st_size // 1024
    convos = len(transcripts["conversations"])
    print(f"  Exported: {out_name} ({size_kb}KB, {convos} conversations)")


def cmd_import_transcripts(path: str) -> None:
    """Import conversation transcripts into current Rappter."""
    if not path:
        print("  Usage: rappter import-transcripts <transcripts.json>")
        return

    p = Path(path)
    if not p.exists():
        print(f"  File not found: {path}")
        return

    data = json.loads(p.read_text())
    if "conversations" not in data:
        print("  Not a valid transcript file")
        return

    memory = load_memory()
    imported = data["conversations"]
    memory["conversations"].extend(imported)
    memory["facts"].extend(data.get("facts", []))
    memory["preferences"].extend(data.get("preferences", []))
    save_memory(memory)
    print(f"  Imported {len(imported)} conversations into memory")


# ── Main ───────────────────────────────────────────────────────────────────

def main() -> None:
    """CLI entry point."""
    args = sys.argv[1:]

    if not args or args[0] in ("-h", "--help", "help"):
        print(__doc__)
        return

    cmd = args[0]

    if cmd == "init":
        cmd_init()
    elif cmd == "chat":
        msg = " ".join(args[1:]) if len(args) > 1 else ""
        cmd_chat(msg)
    elif cmd == "status":
        cmd_status()
    elif cmd == "pull":
        cmd_pull()
    elif cmd == "soul":
        cmd_soul()
    elif cmd == "reset":
        cmd_reset()
    elif cmd == "egg":
        path = args[1] if len(args) > 1 else ""
        cmd_egg(path)
    elif cmd == "hatch":
        path = args[1] if len(args) > 1 else ""
        cmd_hatch(path)
    elif cmd == "export-transcripts":
        path = args[1] if len(args) > 1 else ""
        cmd_export_transcripts(path)
    elif cmd == "import-transcripts":
        path = args[1] if len(args) > 1 else ""
        cmd_import_transcripts(path)
    else:
        # Treat unknown args as a chat message
        cmd_chat(" ".join(args))


if __name__ == "__main__":
    main()
