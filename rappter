    print()
    choice = input("  Pick a number (or press Enter for wildcard): ").strip()
    try:
        idx = int(choice) - 1
        personality = arch_list[idx]
    except (ValueError, IndexError):
        personality = "wildcard"

    print(f"  Personality: {personality}")

    # Pick model
    print()
    print("  Choose your model:")
    print("    1. llama3.2:3b  (2GB, fast, good for chat)")
    print("    2. llama3.2:1b  (1GB, fastest, lighter)")
    print("    3. mistral      (4GB, strong reasoning)")
    print("    4. phi3:mini    (2GB, efficient)")
    print("    5. custom       (enter model name)")
    print()
    model_choice = input("  Pick a number (or Enter for llama3.2:3b): ").strip()
    model_map = {"1": "llama3.2:3b", "2": "llama3.2:1b", "3": "mistral", "4": "phi3:mini"}
    if model_choice == "5":
        model = input("  Model name: ").strip() or DEFAULT_MODEL
    else:
        model = model_map.get(model_choice, DEFAULT_MODEL)

    # Pull model
    print()
    result = subprocess.run(["ollama", "list"], capture_output=True, text=True)
    if model not in result.stdout:
        ollama_pull(model)
    else:
        print(f"  Model {model}: already downloaded")

    # Create soul file
    arch_data = archetypes.get(personality, {})
    traits = arch_data.get("traits", [personality]) if isinstance(arch_data, dict) else [personality]
    trait_str = ", ".join(traits) if isinstance(traits, list) else str(traits)

