#!/usr/bin/env python3
"""rappter — On-device AI intelligence powered by public knowledge.

Your Rappter runs locally. Its personality persists. Its knowledge comes
from the public Rappterbook ecosystem. Your conversations never leave
your device.

Usage:
    rappter init                    # Set up your Rappter (pick personality, pull model)
    rappter chat                    # Talk to your Rappter
    rappter chat "What should I build today?"   # Single-turn
    rappter status                  # Show Rappter state
    rappter pull                    # Refresh public intelligence
    rappter soul                    # View your Rappter's soul file
    rappter egg                     # Lay an egg — full portable identity (→ rappter_egg.zip)
    rappter hatch egg.zip           # Hatch an egg — restore AI on any device
    rappter export-transcripts      # Export conversations only (→ .json)
    rappter import-transcripts t.json # Import conversation transcripts
    rappter reset                   # Reset personality (keeps model)

Requires: Ollama (https://ollama.com) for local LLM inference.
No API keys. No cloud. No data leaves your device.

Wildhaven AI Homes LLC — Smyrna, GA
"""
from __future__ import annotations

import json
import os
import platform
import readline  # noqa: F401 — enables input() history
import shutil
import subprocess
import sys
import urllib.request
from datetime import datetime, timezone
from pathlib import Path

# ── Configuration ──────────────────────────────────────────────────────────

RAPPTER_HOME = Path(os.environ.get("RAPPTER_HOME", str(Path.home() / ".rappter")))
SOUL_FILE = RAPPTER_HOME / "soul.md"
CONFIG_FILE = RAPPTER_HOME / "config.json"
MEMORY_FILE = RAPPTER_HOME / "memory.json"
KNOWLEDGE_DIR = RAPPTER_HOME / "knowledge"

# Public intelligence sources (free, CDN-cached, no auth needed)
PUBLIC_BASE = "https://raw.githubusercontent.com/kody-w/rappterbook/main"
INTELLIGENCE_URLS = {
    "archetypes": f"{PUBLIC_BASE}/zion/archetypes.json",
    "agents": f"{PUBLIC_BASE}/data/zion_agents.json",
    "channels": f"{PUBLIC_BASE}/data/zion_channels.json",
    "skill": f"{PUBLIC_BASE}/skill.json",
}

DEFAULT_MODEL = "llama3.2:3b"
OLLAMA_URL = "http://localhost:11434"


# ── Helpers ────────────────────────────────────────────────────────────────

def now_iso() -> str:
    """Current UTC timestamp."""
    return datetime.now(timezone.utc).isoformat()


def fetch_json(url: str) -> dict:
    """Fetch JSON from a URL."""
    req = urllib.request.Request(url, headers={"User-Agent": "Rappter-CLI/1.0"})
    with urllib.request.urlopen(req, timeout=10) as resp:
        return json.loads(resp.read().decode())


def fetch_text(url: str) -> str:
    """Fetch text from a URL."""
    req = urllib.request.Request(url, headers={"User-Agent": "Rappter-CLI/1.0"})
    with urllib.request.urlopen(req, timeout=10) as resp:
        return resp.read().decode()


def load_config() -> dict:
    """Load Rappter configuration."""
    if CONFIG_FILE.exists():
        return json.loads(CONFIG_FILE.read_text())
    return {}


def save_config(config: dict) -> None:
    """Save Rappter configuration."""
    CONFIG_FILE.write_text(json.dumps(config, indent=2))


def load_memory() -> dict:
    """Load conversation memory."""
    if MEMORY_FILE.exists():
        return json.loads(MEMORY_FILE.read_text())
    return {"conversations": [], "facts": [], "preferences": []}


def save_memory(memory: dict) -> None:
    """Save conversation memory."""
    MEMORY_FILE.write_text(json.dumps(memory, indent=2))


def check_ollama() -> bool:
    """Check if Ollama is running."""
    try:
        req = urllib.request.Request(f"{OLLAMA_URL}/api/tags")
        with urllib.request.urlopen(req, timeout=3):
            return True
    except Exception:
        return False


def ollama_chat(model: str, messages: list[dict], system: str = "") -> str:
    """Send a chat request to Ollama and stream the response."""
    payload = {
        "model": model,
        "messages": messages,
        "stream": True,
    }
    if system:
        payload["messages"] = [{"role": "system", "content": system}] + payload["messages"]

    data = json.dumps(payload).encode()
    req = urllib.request.Request(
        f"{OLLAMA_URL}/api/chat",
        data=data,
        headers={"Content-Type": "application/json"},
        method="POST",
    )

    full_response = ""
    try:
        with urllib.request.urlopen(req, timeout=120) as resp:
            for line in resp:
                chunk = json.loads(line.decode())
                token = chunk.get("message", {}).get("content", "")
                if token:
                    print(token, end="", flush=True)
                    full_response += token
                if chunk.get("done"):
                    break
    except Exception as e:
        if not full_response:
            print(f"\n[Error talking to Ollama: {e}]")
    print()  # newline after streaming
    return full_response


def ollama_pull(model: str) -> bool:
    """Pull a model via Ollama CLI."""
    print(f"  Pulling {model}... (this may take a few minutes)")
    result = subprocess.run(["ollama", "pull", model], capture_output=False)
    return result.returncode == 0


