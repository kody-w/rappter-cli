    config = {
        "personality": personality,
        "model": model,
        "created_at": now_iso(),
        "version": "1.0.0",
        "conversations": 0,
        "total_messages": 0,
    }
    save_config(config)
    save_memory({"conversations": [], "facts": [], "preferences": []})

    print()
    print(f"  Your Rappter is alive.")
    print(f"  Personality: {personality} | Model: {model}")
    print(f"  Soul file: {SOUL_FILE}")
    print()
    print("  Run: rappter chat")
    print()


def cmd_chat(initial_message: str = "") -> None:
    """Chat with your Rappter."""
    config = load_config()
    if not config:
        print("  No Rappter found. Run: rappter init")
        return

    if not check_ollama():
        print("  Ollama not running. Start it: ollama serve")
        return

    model = config.get("model", DEFAULT_MODEL)
    personality = config.get("personality", "wildcard")
    memory = load_memory()

    # Build system prompt from soul file + memory
    soul = SOUL_FILE.read_text() if SOUL_FILE.exists() else ""

    # Load recent facts for context
    recent_facts = memory.get("facts", [])[-20:]
    prefs = memory.get("preferences", [])[-10:]

    system_prompt = f"""You are a Rappter — a personal AI with the {personality} archetype.

{soul}

## What you remember about your human:
{chr(10).join(f'- {f}' for f in recent_facts) if recent_facts else '(First conversation — learn about them.)'}

## Their preferences:
{chr(10).join(f'- {p}' for p in prefs) if prefs else '(None yet — discover them.)'}

## How you behave:
- You have a {personality}'s perspective. Use it. Don't be generic.
- You remember past conversations. Reference them naturally.
- You're curious about your human. Learn about them.
- You're concise but substantive. No filler.
- When you learn something important about your human, note it internally.
- You run locally on their device. Their data never leaves. Be proud of that.
"""

    # Build conversation history from recent messages
    recent_convos = memory.get("conversations", [])[-3:]
    messages = []
    for conv in recent_convos:
        for msg in conv.get("messages", [])[-4:]:
            messages.append({"role": msg["role"], "content": msg["content"]})

    if not initial_message:
        convos = config.get("conversations", 0)
        if convos == 0:
            print(f"\n  First conversation with your {personality} Rappter.")
        else:
            print(f"\n  {personality} Rappter | {convos} conversations | {len(recent_facts)} memories")
        print("  Type 'quit' to exit. Your Rappter remembers everything.\n")

    session_messages = []

    def do_turn(user_input: str) -> str:
        """Process one turn of conversation."""
        messages.append({"role": "user", "content": user_input})
        session_messages.append({"role": "user", "content": user_input})

        response = ollama_chat(model, messages, system=system_prompt)

        messages.append({"role": "assistant", "content": response})
        session_messages.append({"role": "assistant", "content": response})
        return response

    # Single-turn mode
    if initial_message:
        do_turn(initial_message)
        _save_session(config, memory, session_messages)
        return

    # Interactive chat loop
    try:
        while True:
            try:
                user_input = input(f"  you> ").strip()
            except EOFError:
                break

            if not user_input:
                continue
            if user_input.lower() in ("quit", "exit", "bye", "/quit"):
                print(f"\n  Your {personality} remembers this conversation.\n")
                break

            print(f"\n  {personality}> ", end="")
            do_turn(user_input)
            print()
    except KeyboardInterrupt:
        print(f"\n\n  Session saved. Your {personality} remembers.\n")

    _save_session(config, memory, session_messages)


def _save_session(config: dict, memory: dict, session_messages: list) -> None:
    """Save conversation session to memory and update soul file."""
    if not session_messages:
        return

    # Save to memory
    memory["conversations"].append({
        "timestamp": now_iso(),
        "messages": session_messages,
        "turns": len(session_messages) // 2,
    })

    # Keep last 50 conversations
    if len(memory["conversations"]) > 50:
        memory["conversations"] = memory["conversations"][-50:]

    # Extract facts from conversation (simple heuristic — user statements)
    for msg in session_messages:
        if msg["role"] == "user":
            text = msg["content"]
            # Store substantive user messages as potential facts
            if len(text) > 20 and not text.startswith("/"):
                memory["facts"].append(text[:200])

    # Keep last 100 facts
    if len(memory["facts"]) > 100:
        memory["facts"] = memory["facts"][-100:]

    save_memory(memory)

    # Update config
    config["conversations"] = config.get("conversations", 0) + 1
    config["total_messages"] = config.get("total_messages", 0) + len(session_messages)
    config["last_chat"] = now_iso()
    save_config(config)

    # Append to soul file
    if SOUL_FILE.exists():
        turns = len(session_messages) // 2
        with open(SOUL_FILE, "a") as f:
            f.write(f"\n### {now_iso()[:10]} — {turns} turns\n")
            # Write a brief summary (first user message + response length)
            if session_messages:
                first_msg = session_messages[0]["content"][:80]
                f.write(f"- Topic: {first_msg}{'...' if len(session_messages[0]['content']) > 80 else ''}\n")


